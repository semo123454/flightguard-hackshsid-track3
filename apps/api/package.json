{
  "name": "@flightguard/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "db:backup": "tsx --env-file-if-exists=../../.env src/db/backup-cli.ts",
    "data:import": "tsx --env-file-if-exists=../../.env src/db/import-data-cli.ts",
    "evaluate:live": "tsx --env-file-if-exists=../../.env src/llm/evaluate-live.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@flightguard/contracts": "1.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6"
  }
}
